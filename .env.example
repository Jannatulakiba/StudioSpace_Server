# StudioSpace API — environment variables
# Copy me: cp .env.example .env  (then fill in real values; .env is gitignored)

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string (studiospace database)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>?retryWrites=true

# Client origin allowed through CORS + Vercel frontend URL
FRONTEND_URL=http://localhost:3000,https://your-client.vercel.app

# URL of the BetterAuth (Next.js client) host — used to verify JWTs via JWKS
BETTER_AUTH_URL=http://localhost:3000
